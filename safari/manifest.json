{
  "manifest_version": 2,
  "name": "YouTube Downloader",
  "description": "Adds a download button to YouTube that opens YouTube Downloader.",
  "version": "1.0",
  "default_locale": "en",
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["youtube.js"],
    "css": ["youtube.css"],
    "run_at": "document_idle"
  }]
}
